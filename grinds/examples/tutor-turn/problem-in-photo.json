{
  "about": "The first turn, with a photo of a word problem: the tutor reads the problem off the photo as written and does not solve it.",
  "request": {
    "schemaVersion": "1",
    "mode": "problem-in",
    "strictness": "meaning-gated",
    "session_history": []
  },
  "photos": ["pencils-problem.jpg"],
  "expect": {
    "action": "continue",
    "layer_diagnosis": "none",
    "target_text": {"matches":"(?i)24 pencils.*4 tables"},
    "problem_kind": "word",
    "prompt_to_child": {"matches":"(?i)^(?:[^s]|s(?:s|is)*(?:[^si]|i[^sx]))*(?:|s(?:s|is)*(?:|i))$"}
  }
}
