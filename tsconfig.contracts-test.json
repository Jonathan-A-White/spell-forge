{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.contracts-test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* scrypt-ts contracts: legacy decorators, [[Set]] class fields (as tsconfig.contracts.json) */
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // The License and Fuel contracts, the tests that run them, and the bridge the contract-locked
  // builders load lazily (mw-5wuz6.3). Kept out of tsconfig.app.json, whose standard
  // decorators and verbatimModuleSyntax scrypt-ts contracts cannot use; vitest (via this
  // reference) compiles license.ts with these options too.
  "include": [
    "src/bsv/contracts/*.ts",
    "src/bsv/contracts/bridge/*.ts",
    "tests/unit/bsv-contracts-license.test.ts",
    "tests/fixtures/bsv/license-contract.ts",
    "tests/unit/bsv-contracts-fuel.test.ts",
    "tests/fixtures/bsv/fuel-contract.ts",
    "tests/features/steps/license-covenant.steps.ts",
    "tests/features/bsv/license-covenant.test.ts",
    "tests/features/steps/fuel-covenant.steps.ts",
    "tests/features/bsv/fuel-covenant.test.ts"
  ]
}
