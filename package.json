{
  "name": "spell-forge",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vps": "SF_BASE=/ npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:bdd": "vitest run features/steps",
    "test:phone": "playwright test --project=phone",
    "test:nightly": "TZ=UTC vitest run && PW_PHONE=1 playwright test --workers=1",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "test:phonics": "vitest run tests/unit/phonics-engine.test.ts",
    "test:spaced-rep": "vitest run tests/unit/spaced-rep.test.ts tests/unit/difficulty-score.test.ts",
    "test:data": "vitest run tests/unit/data-layer.test.ts",
    "test:audio": "vitest run tests/unit/audio.test.ts",
    "test:ocr": "vitest run tests/unit/ocr.test.ts",
    "test:ocr-integration": "vitest run tests/unit/ocr-image.test.ts",
    "test:themes": "vitest run tests/unit/themes.test.ts",
    "test:a11y": "vitest run tests/unit/accessibility.test.ts",
    "test:adaptive": "vitest run tests/unit/adaptive-engine.test.ts",
    "test:contracts": "vitest run tests/unit/contracts.test.ts",
    "test:pdf": "vitest run tests/unit/pdf-generator.test.ts",
    "test:qr": "vitest run tests/unit/qr-codec.test.ts",
    "test:learning": "vitest run tests/unit/learning-engine.test.ts",
    "test:bsv": "vitest run tests/unit/bsv-",
    "test:bsv:rules": "vitest run tests/features/bsv",
    "test:bsv:testnet": "vitest run -c vitest.testnet.config.ts",
    "bsv:keys": "tsx scripts/bsv-keys.ts",
    "bsv:balance": "tsx scripts/bsv-balance.ts",
    "bsv:contracts:build": "tsx scripts/bsv-contracts-build.ts",
    "bsv:contracts:check": "tsx scripts/bsv-contracts-check.ts",
    "bsv:rules:coverage": "tsx scripts/bsv-rules-coverage.ts",
    "bsv:vectors": "tsx scripts/bsv-wire-vectors.ts",
    "bsv:pack": "sh scripts/bsv-pack.sh",
    "test:bsv:package": "sh scripts/check-bsv-package.sh",
    "test:e2e": "playwright test",
    "tutor:eval": "tsx scripts/tutor-eval.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@bsv/sdk": "^2.2.0",
    "@fontsource/patrick-hand": "^5.2.8",
    "bsv-kit": "github:Jonathan-A-White/bsv-kit#918c441ce443dff052470de5671c2b1c430f8ebd",
    "dexie": "^4.3.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "learn-kit": "github:Jonathan-A-White/learn-kit#866354a9c617f35bf9e85159e72bab0a27b6f02e",
    "ogl": "^1.0.11",
    "pwa-kit": "github:Jonathan-A-White/pwa-kit#011083d67ed4eea69f08177ffa2b04a3b57eb51d",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "voice-kit": "github:Jonathan-A-White/voice-kit#d87188227886ec15e7c34f674992f4a63ea69215",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "scrypt-ord": "1.0.17",
    "scrypt-ts": "1.4.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "github:Jonathan-A-White/bsv-kit#918c441ce443dff052470de5671c2b1c430f8ebd": true,
    "github:Jonathan-A-White/learn-kit#866354a9c617f35bf9e85159e72bab0a27b6f02e": true,
    "github:Jonathan-A-White/pwa-kit#011083d67ed4eea69f08177ffa2b04a3b57eb51d": true,
    "github:Jonathan-A-White/voice-kit#d87188227886ec15e7c34f674992f4a63ea69215": true
  }
}
